{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "checkout": {
        "ClusterId": "ordering",
        "RateLimiterPolicy": "checkout",
        "Match": { "Path": "/api/ordering/orders", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ]
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/ordering/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ]
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5101" } }
      },
      "ordering": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5102" } }
      },
      "inventory": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5103" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
